<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Feed (RSS/Atom sources) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Customize Today → Wallpaper → Phone wallpaper too. -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <!-- Weather beside the date in Today, when "Where I am" is chosen. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Switcher: "close" a background app -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <!-- Switcher: which apps were recently in the foreground (user grants in Settings) -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
    <!-- Status bar: tap / pull opens the system shade, like the N9 status menu -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <!-- Launcher edit mode: the close button uninstalls -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.media.action.STILL_IMAGE_CAMERA" />
        </intent>
        <!-- Icon packs (ADW / Nova / GO formats) -->
        <intent><action android:name="org.adw.launcher.THEMES" /></intent>
        <intent><action android:name="com.novalauncher.THEME" /></intent>
        <intent><action android:name="com.teslacoilsw.launcher.THEME" /></intent>
        <intent><action android:name="com.gau.go.launcherex.theme" /></intent>
        <intent><action android:name="org.adw.launcher.icons.ACTION_PICK_ICON" /></intent>
        <intent><action android:name="com.anddoes.launcher.THEME" /></intent>
        <!-- Shizuku, for mirroring the system's recent apps -->
        <package android:name="moe.shizuku.privileged.api" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@drawable/n9_app_theme"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Harmattan">

        <activity
            android:name=".HomeActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|smallestScreenSize"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="false"
            android:resumeWhilePausing="true"
            android:screenOrientation="portrait"
            android:stateNotNeeded="true"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/settings_name"
            android:screenOrientation="portrait"
            android:taskAffinity="com.amiigo.harmattan.settings">
            <intent-filter>
                <action android:name="android.intent.action.APPLICATION_PREFERENCES" />
                <category android:name="android.intent.category.DEFAULT" />
                
            </intent-filter>
        </activity>


        <!-- Shizuku hands its binder to this app through this provider (optional Recents mirroring). -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <service
            android:name=".EventsListenerService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
